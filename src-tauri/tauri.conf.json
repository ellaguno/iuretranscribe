{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IureTranscribe",
  "version": "0.3.2",
  "identifier": "com.iurefficient.iuretranscribe",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "IureTranscribe",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 620,
        "dragDropEnabled": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Transcripción de audio y video con Whisper",
    "longDescription": "Transcribe audio y video localmente con Whisper (whisper.cpp), genera subtítulos SRT/VTT y, opcionalmente, resumen y minuta con un LLM.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "nsis": {
        "languages": [
          "Spanish",
          "English"
        ],
        "installMode": "currentUser"
      }
    },
    "resources": {
      "resources/models/ggml-base.bin": "models/ggml-base.bin"
    }
  }
}
