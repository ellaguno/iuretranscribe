{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IureTranscribe",
  "version": "0.6.0",
  "identifier": "com.iurefficient.iuretranscribe",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "IureTranscribe",
        "width": 1180,
        "height": 780,
        "minWidth": 720,
        "minHeight": 620,
        "dragDropEnabled": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Audio and video transcription with Whisper",
    "longDescription": "Transcribes audio and video locally with Whisper (whisper.cpp), generates SRT/VTT subtitles and, optionally, a summary and meeting minutes with an LLM.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [],
        "desktopTemplate": "./linux/app.desktop"
      },
      "appimage": {
        "bundleMediaFramework": false
      },
      "rpm": {
        "desktopTemplate": "./linux/app.desktop"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "nsis": {
        "languages": [
          "English",
          "Spanish"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    },
    "resources": {
      "resources/models/ggml-base.bin": "models/ggml-base.bin"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhGMUI0OEUxNjg1NjE1MjUKUldRbEZWWm80VWdiajlpRzB5WFRKY0RFZ01VVGN0TVMrV01LQjZWTUNTa3JsV0VoMFRWQTlmbmUK",
      "endpoints": [
        "https://github.com/ellaguno/iuretranscribe/releases/latest/download/latest.json"
      ]
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "iuretranscribe"
        ]
      }
    }
  }
}
